/css/*
  Cache-Control: public, max-age=300, stale-while-revalidate=600
/js/*
  Cache-Control: public, max-age=300, stale-while-revalidate=600
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/admin
  X-Robots-Tag: noindex, nofollow
/admin.html
  X-Robots-Tag: noindex, nofollow
